# Monorepo .gitignore

# Dependencies
node_modules/
backend/vendor/
frontend/node_modules/

# Environment files
.env
.env.local
.env.*.local
backend/.env
backend/.env.backup
backend/.env.production
frontend/.env.local

# Allow example env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Laravel storage & cache
backend/storage/*.key
backend/storage/pail/
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/public/storage
backend/public/hot
backend/public/build
backend/.phpunit.cache
backend/.phpunit.result.cache

# Frontend build
frontend/dist/
frontend/dist-ssr/
*.local

# System & Editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
